<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: #fafafa95;" stylesheets="@../css/quiz_gen.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.graded_classes.graded_attendance.controller.quiz.QuizGenerator">
   <top>
      <HBox style="-fx-background-color: white; -fx-border-color: rgba(0, 0, 0, 0.2);" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" spacing="5.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: hidden solid hidden hidden;">
               <children>
                  <FontIcon style="-fx-icon-code: mdal-assignment; -fx-icon-size: 24; -fx-icon-color: #1C75BC;" />
                  <Label text="Graded">
                     <font>
                        <Font name="HelveticaRounded-Bold" size="24.0" />
                     </font>
                  </Label>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
            <HBox HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="20.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Dashboard">
                           <font>
                              <Font name="HelveticaRounded-Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label text="Quizzes">
                           <font>
                              <Font name="HelveticaRounded-Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label text="Student">
                           <font>
                              <Font name="HelveticaRounded-Bold" size="16.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </HBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" HBox.hgrow="NEVER">
                     <children>
                        <ComboBox promptText="Subject" />
                        <Separator orientation="VERTICAL">
                           <HBox.margin>
                              <Insets bottom="12.0" top="12.0" />
                           </HBox.margin>
                        </Separator>
                        <Button mnemonicParsing="false" styleClass="button-outlined" text="Save Draft">
                           <font>
                              <Font name="HelveticaRounded-Bold" size="14.0" />
                           </font></Button>
                        <Separator orientation="VERTICAL">
                           <HBox.margin>
                              <Insets bottom="12.0" top="12.0" />
                           </HBox.margin></Separator>
                        <Button mnemonicParsing="false" styleClass="accent" text="Publish">
                           <font>
                              <Font name="HelveticaRounded-Bold" size="14.0" />
                           </font></Button>
                     </children>
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </HBox>
               </children>
            </HBox>
            <HBox alignment="CENTER" minWidth="70.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: hidden hidden hidden solid;" HBox.hgrow="NEVER">
               <children>
                  <FontIcon style="-fx-icon-code: mdoal-account_circle; -fx-icon-size: 32; -fx-icon-color: #1C75BC;" text="" />
                  <ComboBox maxWidth="20.0" minWidth="20.0" style="-fx-background-color: NONE;" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   <left>
      <VBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: hidden solid solid solid;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Create New Quiz">
               <font>
                  <Font name="HelveticaRounded-Bold" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNewTopic" styleClass="button-outlined" text="Add New Topic">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <graphic>
                  <FontIcon style="-fx-icon-code: mdal-add; -fx-font-size: 28; -fx-icon-color: #1C75BC;" />
               </graphic>
               <font>
                  <Font name="HelveticaRounded-Bold" size="16.0" />
               </font>
            </Button>
            <TreeView fx:id="quizTree" showRoot="false" style="-fx-background-radius: 5; -fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-radius: 5;" styleClass="alt-icon" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin></TreeView>
         </children>
      </VBox>
   </left>
   <center>
      <StackPane id="default_pane" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
