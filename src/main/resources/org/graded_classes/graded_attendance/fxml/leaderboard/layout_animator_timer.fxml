<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>

<HBox alignment="CENTER" fillHeight="false" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
      minWidth="-Infinity" xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.graded.LayoutAnimatorTimer">
   <Text fx:id="node_name" strokeType="OUTSIDE" strokeWidth="0.0" text="Name" wrappingWidth="100.0">
      <HBox.margin>
         <Insets left="10.0"/>
      </HBox.margin>
   </Text>
   <Separator prefWidth="200.0" visible="false"/>
   <HBox alignment="CENTER" spacing="50.0">
      <HBox.margin>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
      </HBox.margin>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Layout Duration"/>
      <Spinner fx:id="layout_duration"/>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Fade Time"/>
      <Spinner fx:id="fade_duration"/>
   </HBox>
</HBox>
