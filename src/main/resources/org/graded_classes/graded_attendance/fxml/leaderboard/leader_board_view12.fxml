<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane alignment="TOP_CENTER" stylesheets="@../../css/leaderboard/main_style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.graded_classes.graded_attendance.controller.leaderboard.Leaderboard1">
   <StackPane id="layer" alignment="TOP_CENTER" stylesheets="@../../css/leaderboard/main_style.css" StackPane.alignment="TOP_CENTER" />
   <StackPane id="layer1" alignment="TOP_CENTER" stylesheets="@../../css/leaderboard/main_style.css" StackPane.alignment="TOP_CENTER" />
   <VBox alignment="TOP_CENTER" StackPane.alignment="TOP_CENTER">
      <StackPane.margin>
         <Insets bottom="20.0" left="30.0" right="30.0" />
      </StackPane.margin>
      <Label text="Leaderbaord" textFill="#fffefe" VBox.vgrow="NEVER">
         <font>
            <Font name="☞Gilroy-Bold" size="49.0" />
         </font>
         <VBox.margin>
            <Insets top="30.0" />
         </VBox.margin>
      </Label>
      <HBox alignment="TOP_CENTER" maxHeight="530.0" minHeight="530.0" spacing="20.0" VBox.vgrow="NEVER">
         <VBox.margin>
            <Insets top="30.0" />
         </VBox.margin>
         <VBox id="levels" alignment="CENTER" maxWidth="500.0" minHeight="500.0" spacing="5.0">
            <ImageView fx:id="level2Img" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <Image url="@../../icons/leaderboard/2nd.png" />
            </ImageView>
            <Label fx:id="level2Title" style="-fx-font-size: 28;" text="IronClad" />
            <Label fx:id="level2Name" style="-fx-font-size: 20;" text="Shifa Ahmed" />
            <Label fx:id="level2Point" style="-fx-text-fill: #00FFFF; -fx-font-size: 18;" text="300 Points" />
            <VBox id="inner_box" alignment="TOP_CENTER" maxHeight="150.0" maxWidth="155.0" minHeight="150.0" minWidth="155.0" style="-fx-background-color: #1d1d37; -fx-border-color: #C0C0C0; -fx-border-width: 5; -fx-border-style: solid hidden hidden hidden;">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <Label text="2" />
            </VBox>
         </VBox>
         <VBox id="levels" alignment="CENTER" maxWidth="500.0" minHeight="500.0" spacing="5.0">
            <ImageView fx:id="level1Img" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <Image url="@../../icons/leaderboard/1st.png" />
            </ImageView>
            <Label fx:id="level1Title" style="-fx-font-size: 28;" text="Viperx" />
            <Label fx:id="level1Name" style="-fx-font-size: 20;" text="Sufiya Khan" />
            <Label fx:id="level1Point" style="-fx-text-fill: #FFD700; -fx-font-size: 18;" text="800 Points" />
            <VBox id="inner_box" alignment="TOP_CENTER" maxHeight="240.0" maxWidth="155.0" minHeight="240.0" minWidth="155.0" style="-fx-background-color: #1d1d37; -fx-border-color: #FFD700; -fx-border-width: 5; -fx-border-style: solid hidden hidden hidden;">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <Label text="1" />
            </VBox>
         </VBox>
         <VBox id="levels" alignment="CENTER" spacing="5.0">
            <ImageView fx:id="level3Img" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <Image url="@../../icons/leaderboard/3rd.png" />
            </ImageView>
            <Label fx:id="level3Title" style="-fx-font-size: 28;" text="Shadown" />
            <Label fx:id="level3Name" style="-fx-font-size: 20;" text="Abdul Basit" />
            <Label fx:id="level3Point" style="-fx-text-fill: #EE4B2B; -fx-font-size: 18;" text="200 Points" />
            <VBox id="inner_box" alignment="TOP_CENTER" maxHeight="100.0" maxWidth="155.0" minHeight="100.0" minWidth="155.0" style="-fx-background-color: #1d1d37; -fx-border-color: #EE4B2B; -fx-border-width: 5; -fx-border-style: solid hidden hidden hidden;">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <Label text="3">
                  <font>
                     <Font size="33.0" />
                  </font>
               </Label>
            </VBox>
         </VBox>
      </HBox>
      <StackPane maxHeight="35.0" minHeight="35.0" VBox.vgrow="NEVER">
         <StackPane maxHeight="2.0" minHeight="2.0" style="-fx-background-color: #fafafa;" />
         <Label style="-fx-background-color: #101022;" text="The Top Vengurd" textFill="WHITE" StackPane.alignment="TOP_LEFT">
            <font>
               <Font name="System Bold" size="16.0" />
            </font>
            <StackPane.margin>
               <Insets left="30.0" />
            </StackPane.margin>
            <padding>
               <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </padding>
         </Label>
      </StackPane>
      <VBox fx:id="board" fillWidth="false" prefHeight="300.0" spacing="15.0" VBox.vgrow="ALWAYS" />
   </VBox>
</StackPane>
