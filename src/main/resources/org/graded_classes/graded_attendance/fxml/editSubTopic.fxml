<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.*?>
<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" style="-fx-background-color: #fafafa; -fx-background-radius: 5; -fx-border-radius: 5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.graded_classes.graded_attendance.planner.EditSubTopic">
   <children>
      <HBox alignment="CENTER_RIGHT">
         <VBox.margin>
            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
         </VBox.margin>
         <children>
            <Button contentDisplay="CENTER" graphicTextGap="0.0" maxHeight="16.0" maxWidth="16.0" minHeight="16.0" minWidth="16.0" mnemonicParsing="false" prefHeight="24.0" prefWidth="24.0" wrapText="true">
               <graphic>
                  <FontIcon selectionEnd="0" selectionStart="0" style="-fx-icon-size: 12; -fx-icon-code: mdoal-close;" />
               </graphic>
               <styleClass>
                  <String fx:value="danger" />
                  <String fx:value="rounded" />
                  <String fx:value="button-outlined" />
                  <String fx:value="small" />
               </styleClass>
            </Button>
         </children>
      </HBox>
      <VBox spacing="5.0">
         <children>
            <Label text="Edit Subtopic">
               <font>
                  <Font name="☞Gilroy-Bold" size="16.0" />
               </font>
            </Label>
            <CustomTextField fx:id="editName" promptText="Name" />
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </VBox>
      <HBox alignment="TOP_RIGHT">
         <children>
            <Button mnemonicParsing="false" onAction="#editSubTopicName" styleClass="accent" text="Apply" />
         </children>
         <VBox.margin>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
