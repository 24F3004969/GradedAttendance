<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import org.graded_classes.graded_attendance.components.LatexView?>

<HBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-radius: 5; -fx-background-radius: 5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.graded_classes.graded_attendance.controller.quiz.QuestionOption">
   <children>
      <Label fx:id="name">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <RadioButton fx:id="radio" mnemonicParsing="false" />
      <LatexView fx:id="option_text" size="28" />
      <ImageView fx:id="option_image" pickOnBounds="true" preserveRatio="true" />
   </children>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</HBox>
