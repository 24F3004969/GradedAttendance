<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.RingProgressIndicator?>
<?import com.dlsc.gemsfx.CalendarPicker?>
<?import com.dlsc.gemsfx.SVGImageView?>
<?import com.dlsc.gemsfx.SearchField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true"
            stylesheets="@../css/atlantafx.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.graded_classes.graded_attendance.controller.quiz.DiagnosticExamReport">

   <content>

      <VBox stylesheets="@../css/teaching_progress_view.css">

         <children>

            <VBox prefHeight="641.0"
                  prefWidth="879.0">

               <children>

                  <!-- ================================================= -->
                  <!-- PAGE HEADER                                       -->
                  <!-- ================================================= -->

                  <HBox alignment="CENTER_LEFT"
                        prefHeight="100.0"
                        prefWidth="200.0"
                        style="-fx-border-color: rgba(0, 0, 0, 0.2);">

                     <children>

                        <VBox>

                           <children>

                              <Label fx:id="today"
                                     text="16 May 2026">

                                 <font>
                                    <Font name="System Bold"
                                          size="16.0"/>
                                 </font>

                              </Label>

                              <Label text="Diagnosis Report">

                                 <font>
                                    <Font size="48.0"/>
                                 </font>

                                 <graphic>

                                    <FontIcon style="-fx-icon-code: bi-file-bar-graph-fill;
                                                                 -fx-icon-color: #1c75bc;
                                                                 -fx-icon-size: 48;"/>

                                 </graphic>

                              </Label>

                           </children>

                        </VBox>

                        <HBox alignment="CENTER_RIGHT"
                              spacing="10.0"
                              HBox.hgrow="ALWAYS">

                           <children>

                              <CalendarPicker/>

                              <Button mnemonicParsing="false"
                                      onAction="#generateReport"
                                      styleClass="accent"
                                      text="Generate Report">

                                 <padding>
                                    <Insets bottom="10.0"
                                            left="20.0"
                                            right="20.0"
                                            top="10.0"/>
                                 </padding>

                                 <graphic>

                                    <FontIcon style="-fx-icon-code: gmi-file-download;
                                                                 -fx-icon-size: 18;"/>

                                 </graphic>

                              </Button>

                           </children>

                           <HBox.margin>
                              <Insets right="20.0"/>
                           </HBox.margin>

                        </HBox>

                     </children>

                     <VBox.margin>
                        <Insets/>
                     </VBox.margin>

                     <padding>
                        <Insets bottom="5.0"
                                left="5.0"
                                right="5.0"
                                top="5.0"/>
                     </padding>

                  </HBox>

                  <!-- ================================================= -->
                  <!-- STUDENT SEARCH                                    -->
                  <!-- ================================================= -->

                  <HBox alignment="CENTER"
                        minHeight="20.0"
                        prefHeight="30.0"
                        VBox.vgrow="ALWAYS">

                     <children>

                        <SearchField fx:id="search"
                                     prefWidth="400.0"
                                     promptText="Diagnostic student name"/>

                     </children>

                     <VBox.margin>
                        <Insets bottom="15.0"
                                left="15.0"
                                right="15.0"
                                top="15.0"/>
                     </VBox.margin>

                  </HBox>

                  <!-- ================================================= -->
                  <!-- REPORT                                            -->
                  <!-- ================================================= -->

                  <VBox fx:id="report"
                        VBox.vgrow="ALWAYS">

                     <children>

                        <!-- ========================================= -->
                        <!-- STUDENT AND OVERALL RESULT                -->
                        <!-- ========================================= -->

                        <HBox prefHeight="100.0"
                              prefWidth="200.0"
                              style="-fx-background-color: #fafafa;
                                             -fx-border-color: rgba(0, 0, 0, 0.2);
                                             -fx-border-radius: 5;
                                             -fx-background-radius: 5;
                                             -fx-effect: dropshadow(
                                                 gaussian,
                                                 rgba(0, 0, 0, 0.1),
                                                 10,
                                                 0.12,
                                                 -1.0,
                                                 2.0
                                             );">

                           <children>

                              <!-- Student identity -->

                              <HBox prefWidth="300.0"
                                    style="-fx-background-color: #fafafa;">

                                 <children>

                                    <StackPane maxHeight="80.0"
                                               maxWidth="80.0"
                                               minHeight="80.0"
                                               minWidth="80.0"
                                               style="-fx-background-color: #d3e0f7;
                                                                  -fx-background-radius: 50;">

                                       <children>

                                          <Text id="num"
                                                fx:id="avatar"
                                                strokeType="OUTSIDE"
                                                strokeWidth="0.0"
                                                text="UN"
                                                StackPane.alignment="CENTER">

                                             <font>
                                                <Font name="System Bold"
                                                      size="33.0"/>
                                             </font>

                                          </Text>

                                       </children>

                                       <HBox.margin>
                                          <Insets bottom="10.0"
                                                  left="10.0"
                                                  right="10.0"
                                                  top="10.0"/>
                                       </HBox.margin>

                                    </StackPane>

                                    <VBox HBox.hgrow="ALWAYS">

                                       <children>

                                          <Label id="name"
                                                 fx:id="name_class"
                                                 text="Unknown">

                                             <font>
                                                <Font name="System Bold"
                                                      size="16.0"/>
                                             </font>

                                          </Label>

                                          <Label fx:id="class_of"
                                                 text="Diagnostic Test"/>

                                          <Label fx:id="roll_no"
                                                 text="Unregistered Candidate"/>

                                       </children>

                                       <HBox.margin>
                                          <Insets bottom="10.0"
                                                  left="10.0"
                                                  right="10.0"
                                                  top="10.0"/>
                                       </HBox.margin>

                                    </VBox>

                                 </children>

                              </HBox>

                              <!-- Overall result cards -->

                              <HBox alignment="CENTER"
                                    prefHeight="100.0"
                                    prefWidth="200.0"
                                    spacing="20.0"
                                    HBox.hgrow="ALWAYS">

                                 <children>

                                    <!-- Overall percentage -->

                                    <VBox alignment="CENTER"
                                          spacing="8.0"
                                          style="-fx-background-color: #fafafa;
                                                             -fx-background-radius: 5;
                                                             -fx-border-radius: 5;
                                                             -fx-border-color: rgba(0, 0, 0, 0.2);"
                                          HBox.hgrow="ALWAYS">

                                       <children>

                                          <Label text="Overall Percentage">

                                             <font>
                                                <Font name="System Bold"
                                                      size="15.0"/>
                                             </font>

                                          </Label>

                                          <RingProgressIndicator fx:id="allSubjectPercentage"
                                                                 maxHeight="1.7976931348623157E308"
                                                                 maxWidth="1.7976931348623157E308"
                                                                 minHeight="150.0"
                                                                 minWidth="150.0"
                                                                 progress="0.0"/>

                                          <Label fx:id="totalRemark"
                                                 text="---">

                                             <font>
                                                <Font name="System Bold"
                                                      size="14.0"/>
                                             </font>

                                          </Label>

                                       </children>

                                       <padding>
                                          <Insets bottom="5.0"
                                                  left="5.0"
                                                  right="5.0"
                                                  top="5.0"/>
                                       </padding>

                                    </VBox>

                                    <!-- Total marks -->

                                    <VBox alignment="CENTER"
                                          spacing="10.0"
                                          style="-fx-background-color: #fafafa;
                                                             -fx-background-radius: 5;
                                                             -fx-border-radius: 5;
                                                             -fx-border-color: rgba(0, 0, 0, 0.2);"
                                          HBox.hgrow="ALWAYS">

                                       <children>

                                          <Label text="Total Marks">

                                             <font>
                                                <Font name="System Bold"
                                                      size="15.0"/>
                                             </font>

                                          </Label>

                                          <HBox alignment="CENTER">

                                             <children>

                                                <Label fx:id="marks_obtain"
                                                       text="---"
                                                       textFill="#1c75bc">

                                                   <font>
                                                      <Font name="System Bold"
                                                            size="36.0"/>
                                                   </font>

                                                </Label>

                                                <Label fx:id="total_marks"
                                                       text=" / ---">

                                                   <font>
                                                      <Font name="System Bold"
                                                            size="29.0"/>
                                                   </font>

                                                </Label>

                                             </children>

                                          </HBox>

                                          <Label text="Obtained">

                                             <font>
                                                <Font name="System Bold"
                                                      size="15.0"/>
                                             </font>

                                          </Label>

                                       </children>

                                    </VBox>

                                    <!-- Grade -->

                                    <VBox alignment="CENTER"
                                          spacing="10.0"
                                          style="-fx-background-color: #fafafa;
                                                             -fx-background-radius: 5;
                                                             -fx-border-radius: 5;
                                                             -fx-border-color: rgba(0, 0, 0, 0.2);"
                                          HBox.hgrow="ALWAYS">

                                       <children>

                                          <Label text="Grade">

                                             <font>
                                                <Font name="System Bold"
                                                      size="15.0"/>
                                             </font>

                                          </Label>

                                          <Label fx:id="grade"
                                                 text="---"
                                                 textFill="GREEN">

                                             <font>
                                                <Font name="System Bold"
                                                      size="29.0"/>
                                             </font>

                                          </Label>

                                          <Label fx:id="overAllRemark"
                                                 text="---">

                                             <font>
                                                <Font name="System Bold"
                                                      size="15.0"/>
                                             </font>

                                          </Label>

                                       </children>

                                    </VBox>

                                    <!-- Rank -->

                                    <VBox alignment="CENTER"
                                          spacing="10.0"
                                          style="-fx-background-color: #fafafa;
                                                             -fx-background-radius: 5;
                                                             -fx-border-radius: 5;
                                                             -fx-border-color: rgba(0, 0, 0, 0.2);"
                                          HBox.hgrow="ALWAYS">

                                       <children>

                                          <Label text="Rank">

                                             <font>
                                                <Font name="System Bold"
                                                      size="15.0"/>
                                             </font>

                                          </Label>

                                          <Label fx:id="rank"
                                                 text="N/A"
                                                 textFill="#1c75bc">

                                             <font>
                                                <Font name="System Bold"
                                                      size="29.0"/>
                                             </font>

                                          </Label>

                                          <Label text="Diagnostic">

                                             <font>
                                                <Font name="System Bold"
                                                      size="15.0"/>
                                             </font>

                                          </Label>

                                       </children>

                                    </VBox>

                                 </children>

                                 <HBox.margin>
                                    <Insets bottom="5.0"
                                            left="5.0"
                                            right="5.0"
                                            top="5.0"/>
                                 </HBox.margin>

                              </HBox>

                           </children>

                           <padding>
                              <Insets bottom="10.0"
                                      left="10.0"
                                      right="10.0"
                                      top="10.0"/>
                           </padding>

                           <VBox.margin>
                              <Insets bottom="10.0"
                                      left="10.0"
                                      right="10.0"
                                      top="10.0"/>
                           </VBox.margin>

                        </HBox>

                        <!-- ========================================= -->
                        <!-- SUBJECT PERFORMANCE HEADING               -->
                        <!-- ========================================= -->

                        <Label text="Student Performance">

                           <font>
                              <Font name="System Bold"
                                    size="19.0"/>
                           </font>

                           <VBox.margin>
                              <Insets bottom="5.0"
                                      left="10.0"
                                      right="5.0"
                                      top="5.0"/>
                           </VBox.margin>

                        </Label>

                        <!-- ========================================= -->
                        <!-- MATH AND BASIC SCIENCE                    -->
                        <!-- ========================================= -->

                        <HBox fx:id="performanceLayer"
                              alignment="CENTER"
                              spacing="20.0">

                           <children>

                              <!-- ================================= -->
                              <!-- MATHEMATICS                       -->
                              <!-- ================================= -->

                              <VBox id="Math"
                                    fx:id="mathResult"
                                    alignment="CENTER"
                                    maxWidth="320.0"
                                    minWidth="300.0"
                                    prefWidth="320.0"
                                    spacing="8.0"
                                    style="-fx-background-color: #fafafa;
                                                     -fx-background-radius: 5;
                                                     -fx-border-radius: 5;
                                                     -fx-border-color: rgba(0, 0, 0, 0.2);
                                                     -fx-effect: dropshadow(
                                                         gaussian,
                                                         rgba(0, 0, 0, 0.1),
                                                         10,
                                                         0.12,
                                                         -1.0,
                                                         2.0
                                                     );"
                                    HBox.hgrow="ALWAYS">

                                 <children>

                                    <HBox alignment="CENTER">

                                       <children>

                                          <Label graphicTextGap="10.0"
                                                 text="Mathematics"
                                                 textFill="#1c75bc">

                                             <graphic>

                                                <StackPane style="-fx-background-color: #1c75bc;
                                                                                  -fx-background-radius: 50;">

                                                   <children>

                                                      <FontIcon style="-fx-icon-code: bi-calculator;
                                                                                         -fx-icon-size: 28;
                                                                                         -fx-icon-color: #fafafa;"/>

                                                   </children>

                                                   <padding>
                                                      <Insets bottom="15.0"
                                                              left="15.0"
                                                              right="15.0"
                                                              top="15.0"/>
                                                   </padding>

                                                </StackPane>

                                             </graphic>

                                             <font>
                                                <Font name="System Bold"
                                                      size="14.0"/>
                                             </font>

                                          </Label>

                                       </children>

                                    </HBox>

                                    <!--
                                        CSS IDs are intentionally
                                        repeated inside separate
                                        subject containers.
                                    -->

                                    <RingProgressIndicator id="percentage"
                                                           maxHeight="1.7976931348623157E308"
                                                           maxWidth="1.7976931348623157E308"
                                                           minHeight="150.0"
                                                           minWidth="150.0"
                                                           progress="0.0"
                                                           styleClass="math"/>

                                    <Label id="marks"
                                           text="0/0">

                                       <font>
                                          <Font size="16.0"/>
                                       </font>

                                       <VBox.margin>
                                          <Insets bottom="5.0"
                                                  left="5.0"
                                                  right="5.0"
                                                  top="5.0"/>
                                       </VBox.margin>

                                    </Label>

                                    <Separator prefWidth="200.0"/>

                                    <Label id="garde"
                                           text="-"
                                           textFill="#1c75bc">

                                       <font>
                                          <Font name="System Bold"
                                                size="13.0"/>
                                       </font>

                                       <VBox.margin>
                                          <Insets bottom="5.0"
                                                  left="5.0"
                                                  right="5.0"
                                                  top="5.0"/>
                                       </VBox.margin>

                                    </Label>

                                 </children>

                                 <padding>
                                    <Insets bottom="10.0"
                                            left="20.0"
                                            right="20.0"
                                            top="10.0"/>
                                 </padding>

                              </VBox>

                              <!-- ================================= -->
                              <!-- BASIC SCIENCE                     -->
                              <!-- ================================= -->

                              <VBox id="Basic Science"
                                    fx:id="basicScienceResult"
                                    alignment="CENTER"
                                    maxWidth="320.0"
                                    minWidth="300.0"
                                    prefWidth="320.0"
                                    spacing="8.0"
                                    style="-fx-background-color: #fafafa;
                                                     -fx-background-radius: 5;
                                                     -fx-border-radius: 5;
                                                     -fx-border-color: rgba(0, 0, 0, 0.2);
                                                     -fx-effect: dropshadow(
                                                         gaussian,
                                                         rgba(0, 0, 0, 0.1),
                                                         10,
                                                         0.12,
                                                         -1.0,
                                                         2.0
                                                     );"
                                    HBox.hgrow="ALWAYS">

                                 <children>

                                    <HBox alignment="CENTER">

                                       <children>

                                          <Label graphicTextGap="10.0"
                                                 text="Basic Science"
                                                 textFill="#10b981">

                                             <graphic>

                                                <StackPane style="-fx-background-color: #10b981;
                                                                                  -fx-background-radius: 50;">

                                                   <children>

                                                      <FontIcon style="-fx-icon-code: mdi2a-atom;
                                                                                         -fx-icon-size: 28;
                                                                                         -fx-icon-color: #fafafa;"/>

                                                   </children>

                                                   <padding>
                                                      <Insets bottom="15.0"
                                                              left="15.0"
                                                              right="15.0"
                                                              top="15.0"/>
                                                   </padding>

                                                </StackPane>

                                             </graphic>

                                             <font>
                                                <Font name="System Bold"
                                                      size="14.0"/>
                                             </font>

                                          </Label>

                                       </children>

                                    </HBox>

                                    <RingProgressIndicator id="percentage"
                                                           maxHeight="1.7976931348623157E308"
                                                           maxWidth="1.7976931348623157E308"
                                                           minHeight="150.0"
                                                           minWidth="150.0"
                                                           progress="0.0"
                                                           styleClass="phy"/>

                                    <Label id="marks"
                                           text="0/0">

                                       <font>
                                          <Font size="16.0"/>
                                       </font>

                                       <VBox.margin>
                                          <Insets bottom="5.0"
                                                  left="5.0"
                                                  right="5.0"
                                                  top="5.0"/>
                                       </VBox.margin>

                                    </Label>

                                    <Separator prefWidth="200.0"/>

                                    <Label id="garde"
                                           text="-"
                                           textFill="#10b981">

                                       <font>
                                          <Font name="System Bold"
                                                size="13.0"/>
                                       </font>

                                       <VBox.margin>
                                          <Insets bottom="5.0"
                                                  left="5.0"
                                                  right="5.0"
                                                  top="5.0"/>
                                       </VBox.margin>

                                    </Label>

                                 </children>

                                 <padding>
                                    <Insets bottom="10.0"
                                            left="20.0"
                                            right="20.0"
                                            top="10.0"/>
                                 </padding>

                              </VBox>

                           </children>

                           <VBox.margin>
                              <Insets bottom="10.0"
                                      left="10.0"
                                      right="10.0"
                                      top="10.0"/>
                           </VBox.margin>

                           <padding>
                              <Insets bottom="10.0"
                                      left="10.0"
                                      right="10.0"
                                      top="10.0"/>
                           </padding>

                        </HBox>

                        <!-- ========================================= -->
                        <!-- TEACHER REMARK                            -->
                        <!-- ========================================= -->

                        <HBox alignment="CENTER_LEFT"
                              prefHeight="100.0"
                              prefWidth="200.0"
                              spacing="20.0"
                              style="-fx-background-color: #fafafa;
                                             -fx-border-color: rgba(0, 0, 0, 0.2);
                                             -fx-border-radius: 5;
                                             -fx-background-radius: 5;
                                             -fx-effect: dropshadow(
                                                 gaussian,
                                                 rgba(0, 0, 0, 0.1),
                                                 10,
                                                 0.12,
                                                 -1.0,
                                                 2.0
                                             );">

                           <children>

                              <StackPane style="-fx-background-color: #1c75bc20;
                                                          -fx-background-radius: 5;">

                                 <children>

                                    <FontIcon style="-fx-icon-code: fa-star;
                                                                 -fx-icon-size: 36;
                                                                 -fx-icon-color: #1c75bc;"/>

                                 </children>

                                 <padding>
                                    <Insets bottom="5.0"
                                            left="5.0"
                                            right="5.0"
                                            top="5.0"/>
                                 </padding>

                              </StackPane>

                              <VBox prefHeight="100.0"
                                    prefWidth="100.0"
                                    HBox.hgrow="ALWAYS">

                                 <children>

                                    <Label text="Teacher's Remark">

                                       <font>
                                          <Font name="System Bold"
                                                size="14.0"/>
                                       </font>

                                    </Label>

                                    <Label fx:id="remarks"
                                           maxWidth="1.7976931348623157E308"
                                           text="-----"
                                           wrapText="true"/>

                                 </children>

                              </VBox>

                           </children>

                           <VBox.margin>
                              <Insets bottom="10.0"
                                      left="20.0"
                                      right="20.0"
                                      top="10.0"/>
                           </VBox.margin>

                           <padding>
                              <Insets bottom="10.0"
                                      left="10.0"
                                      right="10.0"
                                      top="10.0"/>
                           </padding>

                        </HBox>

                        <!-- ========================================= -->
                        <!-- FOOTER LOGO                               -->
                        <!-- ========================================= -->

                        <HBox alignment="CENTER"
                              prefHeight="100.0"
                              prefWidth="200.0"
                              spacing="20.0">

                           <children>

                              <SVGImageView fx:id="icons"
                                            fitHeight="48.0"
                                            preserveRatio="true"/>

                           </children>

                           <VBox.margin>
                              <Insets bottom="10.0"
                                      left="10.0"
                                      right="10.0"
                                      top="10.0"/>
                           </VBox.margin>

                        </HBox>

                     </children>

                  </VBox>

               </children>

            </VBox>

         </children>

      </VBox>

   </content>

</ScrollPane>