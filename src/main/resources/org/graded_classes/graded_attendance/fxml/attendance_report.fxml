<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="700.0" maxWidth="700.0" minHeight="700.0" minWidth="700.0" prefHeight="700.0" prefWidth="700.0" style="-fx-background-color: #fafafa; -fx-background-radius: 5; -fx-border-radius: 5;" stylesheets="@../css/chartStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.graded_classes.graded_attendance.controller.home.AttendanceReportController">
   <HBox alignment="CENTER">
      <children>
         <Spinner fx:id="months" />
      </children>
      <VBox.margin>
         <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </VBox.margin>
   </HBox>
    <Label fx:id="nameLabel" text="Name">
      <VBox.margin>
         <Insets top="10.0" />
      </VBox.margin>
   </Label>
   <PieChart fx:id="attendanceChart" stylesheets="@../css/chart-style.css" title="Student Attendance Report" VBox.vgrow="ALWAYS" />
   <Button mnemonicParsing="false" onAction="#showFullYearReport" prefHeight="37.0" prefWidth="286.0" styleClass="accent" text="Full year report">
      <VBox.margin>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </VBox.margin></Button>
</VBox>
