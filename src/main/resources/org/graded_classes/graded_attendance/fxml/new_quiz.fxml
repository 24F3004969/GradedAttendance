<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="288.0" style="-fx-background-color: #fafafa; -fx-background-radius: 5; -fx-border-radius: 5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.graded_classes.graded_attendance.controller.quiz.NewQuiz">
   <children>
      <Label text="Topic Name">
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin>
         <font>
            <Font size="16.0" />
         </font></Label>
      <VBox spacing="15.0">
         <children>
            <HBox>
               <children>
                  <Label fx:id="quizName" text="Quiz Name">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <VBox>
               <children>
                  <Label text="No. of Question">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <Spinner fx:id="NoOfQuestion" maxWidth="1.7976931348623157E308">
                     <VBox.margin>
                        <Insets left="4.0" />
                     </VBox.margin>
                  </Spinner>
               </children>
            </VBox>
            <VBox>
               <children>
                  <Label text="Select class">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="classes" maxWidth="1.7976931348623157E308" prefWidth="150.0">
                     <VBox.margin>
                        <Insets left="4.0" />
                     </VBox.margin>
                  </ComboBox>
               </children>
            </VBox>
            <TilePane fx:id="selectorDisplay" hgap="5.0" vgap="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button mnemonicParsing="false" text="Button" />
                  <Button mnemonicParsing="false" text="Button" />
                  <Button mnemonicParsing="false" text="Button" />
               </children></TilePane>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onButtonClick" styleClass="accent" text="Apply" />
                  <Button layoutX="159.0" layoutY="10.0" mnemonicParsing="false" onAction="#onButtonClick" styleClass="danger" text="Cancel" />
               </children>
            </HBox>
         </children>
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </VBox>
   </children>
</VBox>
