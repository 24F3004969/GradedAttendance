<?import org.graded_classes.graded_attendance.components.LatexView?>

<VBox style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: hidden solid hidden hidden;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <SplitPane dividerPositions="0.5" orientation="VERTICAL" VBox.vgrow="ALWAYS">
         <items>
            <SplitPane dividerPositions="0.8">
               <items>
                  <ScrollPane fitToWidth="true">
                     <content>
                        <VBox>
                           <children>
                              <LatexView formula="\\\\text{Question 1.}\\\\\text{For which values of } x \text{ does the power series}\[\sum_{n=1}^{\infty} (-1)^{n+1}n(x-2)^n\] \text{ converge?}" size="28" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
                  <ScrollPane>
                     <content>
                        <StackPane prefHeight="150.0" prefWidth="200.0" />
                     </content>
                  </ScrollPane>
               </items>
            </SplitPane>
            <ScrollPane style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: solid hidden hidden hidden;">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-radius: 5; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
                           <children>
                              <Label text="A)">
                                 <font>
                                    <Font size="24.0" />
                                 </font>
                              </Label>
                              <RadioButton mnemonicParsing="false">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="ans" />
                                 </toggleGroup>
                              </RadioButton>
                              <LatexView formula="x = 1 \text{ and } x = 3" size="28" />
                           </children>
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-radius: 5; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
                           <children>
                              <Label text="B)">
                                 <font>
                                    <Font size="24.0" />
                                 </font>
                              </Label>
                              <RadioButton mnemonicParsing="false" toggleGroup="$ans" />
                              <LatexView formula="x = 0 \text{ and } x = -1" size="28" />
                           </children>
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-radius: 5; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
                           <children>
                              <Label text="C)">
                                 <font>
                                    <Font size="24.0" />
                                 </font>
                              </Label>
                              <RadioButton mnemonicParsing="false" toggleGroup="$ans" />
                              <LatexView formula="x = 12 \text{ and } x = 0" size="28" />
                           </children>
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-radius: 5; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
                           <children>
                              <Label text="D)">
                                 <font>
                                    <Font size="24.0" />
                                 </font>
                              </Label>
                              <RadioButton mnemonicParsing="false" toggleGroup="$ans" />
                              <LatexView formula="x = 7 \text{ and } x = -3" size="28" />
                              <ImageView pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../icons/OPT.png" />
                                 </image>
                              </ImageView>
                           </children>
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-radius: 5; -fx-background-radius: 5;">
                           <children>
                              <Label text="D)">
                                 <font>
                                    <Font size="24.0" />
                                 </font>
                              </Label>
                              <RadioButton mnemonicParsing="false">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="ans1" />
                                 </toggleGroup>
                              </RadioButton>
                              <LatexView formula="x = 7 \text{ and } x = -3" size="28" />
                              <ImageView pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../icons/OPT.png" />
                                 </image>
                              </ImageView>
                           </children>
                           <padding>
