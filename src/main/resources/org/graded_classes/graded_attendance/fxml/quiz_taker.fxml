<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane prefHeight="600.0" style="-fx-background-color: #fafafa95;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.graded_classes.graded_attendance.controller.quiz.QuizTaker">
   <top>
      <HBox style="-fx-background-color: white; -fx-border-color: rgba(0, 0, 0, 0.2);" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" spacing="5.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: hidden solid hidden hidden;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <ImageView fitHeight="26.0" fitWidth="43.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../icons/ed_short.svg" />
                     </image>
                  </ImageView>
               </children>
            </HBox>
            <HBox HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="20.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="quizName" text="Quiz(Math) ">
                           <font>
                              <Font name="HelveticaRounded-Bold" size="16.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </HBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" HBox.hgrow="NEVER">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                     <children>
                        <Label fx:id="timer" text="01:29:12">
                           <font>
                              <Font name="HelveticaRounded-Bold" size="16.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </HBox>
            <HBox alignment="CENTER" minWidth="70.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: hidden hidden hidden solid;" HBox.hgrow="NEVER">
               <children>
                  <FontIcon style="-fx-icon-code: mdoal-account_circle; -fx-icon-size: 32; -fx-icon-color: #1C75BC;" text="" />
                  <ComboBox maxWidth="20.0" minWidth="20.0" style="-fx-background-color: NONE;" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   <right>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="10.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: hidden hidden  solid  hidden;" styleClass="question-icons" stylesheets="@../css/quiz.css">
               <children>
                  <HBox spacing="10.0">
                     <children>
                        <Label contentDisplay="TOP" text="Question Answred" textFill="GREEN">
                           <graphic>
                              <FontIcon id="question-icons" iconSize="64" selectionEnd="0" selectionStart="0" style="-fx-icon-code: mdsal-live_help; -fx-icon-color: green;" styleClass="question-icons" />
                           </graphic>
                           <font>
                              <Font name="HelveticaRounded-Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label contentDisplay="TOP" text="Question not answred" textFill="RED">
                           <graphic>
                              <FontIcon id="question-icons" selectionEnd="0" selectionStart="0" style="-fx-icon-code: mdsal-live_help; -fx-icon-color: red;" styleClass="question-icons" />
                           </graphic>
                           <font>
                              <Font name="HelveticaRounded-Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label contentDisplay="TOP" text="Question not Visited">
                           <graphic>
                              <FontIcon id="question-icons" selectionEnd="0" selectionStart="0" style="-fx-icon-code: mdsal-live_help;" styleClass="question-icons" />
                           </graphic>
                           <font>
                              <Font name="HelveticaRounded-Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <content>
                  <TilePane fx:id="questionNum" hgap="5.0" vgap="5.0" />
               </content>
            </ScrollPane>
            <HBox alignment="CENTER_RIGHT" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: solid hidden hidden hidden;">
               <children>
                  <Button mnemonicParsing="false" onAction="#onQuizSubmit" styleClass="accent" text="Submit">
                     <font>
                        <Font name="HelveticaRounded-Bold" size="12.0" />
                     </font></Button>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </right>
   <center>
      <VBox fx:id="questionStack" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: hidden solid hidden hidden;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_RIGHT" spacing="5.0" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: hidden hidden solid hidden;">
               <children>
                  <HBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="question_num" text="Question 1">
                           <font>
                              <Font size="22.0" />
                           </font>
                           <HBox.margin>
                              <Insets left="3.0" />
                           </HBox.margin>
                        </Label>
                     </children>
                  </HBox>
                  <Label text="Marks for correct answer :">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label text="4" textFill="#26ab02">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Separator orientation="VERTICAL" />
                  <Label text="Negative Marks : ">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label text="-0.25" textFill="#f20909">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <HBox.margin>
                        <Insets right="2.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>
            <VBox fx:id="questionView" VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" style="-fx-border-color: rgba(0, 0, 0, 0.2); -fx-border-style: solid hidden hidden hidden;">
               <children>
                  <HBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Button maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#previousQuestion" styleClass="accent" text="Mark for Reiew &amp; Next">
                           <font>
                              <Font name="HelveticaRounded-Bold" size="12.0" />
                           </font></Button>
                        <Button maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#clearRespond" text="Clear Respond" />
                     </children>
                  </HBox>
                  <HBox spacing="5.0">
                     <children>
                        <Button maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#previousQuestion" styleClass="accent" text="Previous">
                           <font>
                              <Font name="HelveticaRounded-Bold" size="12.0" />
                           </font>
                        </Button>
                        <Button maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#nextQuestion" styleClass="accent" text="Save &amp; Next">
                           <font>
                              <Font name="HelveticaRounded-Bold" size="12.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
