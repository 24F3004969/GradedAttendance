<?xml version="1.0" encoding="UTF-8"?>

<?import com.dlsc.gemsfx.SimpleFilterView?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefHeight="558.0" prefWidth="970.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.graded_classes.graded_attendance.controller.quiz.ConductExam">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
            <children>
                <VBox>
                    <children>
                        <Label fx:id="today" text="16 May 2026">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="Exam Maestro">
                            <font>
                                <Font size="48.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" onAction="#addDiagnosticExam" styleClass="diagnostic-btn" text="Diagnostic Test">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#addNewExam" styleClass="add-exam-btn" text="Add Exam">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                    </children>
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </HBox>
            </children>
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </VBox.margin>
        </HBox>
      <HBox alignment="CENTER_LEFT">
         <VBox.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </VBox.margin>
         <children>
            <SimpleFilterView fx:id="filters" spacing="5.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </SimpleFilterView>
             <Button fx:id="deleteSelectedBtn" managed="false" styleClass="bulk-delete-btn" text="Button" visible="false" />
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
               <children>
                  <ToggleButton mnemonicParsing="false" selected="true" styleClass="left-pill" text="Normal(MCQ/MSQ/NAT) Test">
                     <toggleGroup>
                        <ToggleGroup fx:id="typeType" />
                     </toggleGroup>
                     <graphic>
                        <FontIcon style="-fx-icon-code: fth-book;" />
                     </graphic>
                  </ToggleButton>
                  <ToggleButton mnemonicParsing="false" styleClass="center-pill" text="Diagnostic(MCQ/MSQ/NAT) Test" toggleGroup="$typeType">
                     <graphic>
                        <FontIcon style="-fx-icon-code: fth-bar-chart-2;" />
                     </graphic></ToggleButton>
                  <ToggleButton mnemonicParsing="false" styleClass="right-pill" text="Written Test" toggleGroup="$typeType">
                     <graphic>
                        <FontIcon style="-fx-icon-code: fth-file-text;" />
                     </graphic></ToggleButton>
               </children>
            </HBox>         </children>
      </HBox>
        <TableView fx:id="scheduleTable" prefHeight="200.0" prefWidth="200.0" stylesheets="@../css/time_table.css" VBox.vgrow="ALWAYS">
            <columns>
            <TableColumn fx:id="checkboxes" maxWidth="40.0" prefWidth="40.0" />
                <TableColumn fx:id="id" prefWidth="75.0" text="Id" />
                <TableColumn fx:id="topic" prefWidth="75.0" text="Topics" />
                <TableColumn fx:id="subject" prefWidth="75.0" text="Subject" />
                <TableColumn fx:id="classes" prefWidth="75.0" text="Classes" />
                <TableColumn fx:id="doe" prefWidth="75.0" text="Date of Exam" />
                <TableColumn fx:id="time" prefWidth="75.0" text="Time" />
                <TableColumn fx:id="room" prefWidth="75.0" text="Room No" />
                <TableColumn fx:id="action" prefWidth="200.0" text="Action" />
                <TableColumn fx:id="generate" prefWidth="50.0" text="Generate" />
                <TableColumn fx:id="add" prefWidth="50.0" text="Add" />

                <TableColumn fx:id="share" prefWidth="145.0" text="Share" />

            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
   <stylesheets>
      <URL value="@../css/atlantafx.css" />
      <URL value="@../css/exam.css" />
   </stylesheets>
</VBox>
