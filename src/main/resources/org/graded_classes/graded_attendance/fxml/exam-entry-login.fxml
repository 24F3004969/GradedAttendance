                        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                     </padding>
                     <styleClass>
                        <String fx:value="danger" />
                        <String fx:value="flat" />
                     </styleClass>
                  </Button>
               </children>
            </HBox>
         </children>
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
